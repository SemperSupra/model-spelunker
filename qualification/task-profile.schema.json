{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/SemperSupra/model-spelunker/qualification/task-profile.schema.json",
  "title": "Qualification Task Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "task_class",
    "instruction",
    "fixture",
    "verifier",
    "limits",
    "success"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "task_class": {
      "type": "string",
      "minLength": 1
    },
    "instruction": {
      "type": "string",
      "minLength": 1
    },
    "fixture": {
      "type": "string",
      "minLength": 1
    },
    "verifier": {
      "type": "string",
      "minLength": 1
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_seconds"
      ],
      "properties": {
        "wall_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "allowed_write_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "projected_tools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "demands": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "ksa_requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family",
          "name",
          "evidence_role"
        ],
        "properties": {
          "family": {
            "type": "string",
            "enum": [
              "knowledge",
              "skills",
              "abilities"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "evidence_role": {
            "type": "string",
            "enum": [
              "isolating",
              "composite",
              "supporting"
            ]
          }
        }
      }
    },
    "demand_factors": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean"
        ]
      }
    },
    "locale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "ksa_requirements"
        ]
      }
    }
  ]
}
