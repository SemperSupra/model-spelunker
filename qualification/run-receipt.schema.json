{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/SemperSupra/model-spelunker/qualification/run-receipt.schema.json",
  "title": "Configured Actor Qualification Run Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "task",
    "candidate",
    "substrate",
    "observation",
    "evidence_digest"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9-]+$"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_commit",
        "package_digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "package_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harness",
        "model",
        "configuration_digest",
        "toolset"
      ],
      "properties": {
        "harness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "id"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "artifact_ref": {
              "type": "string"
            }
          }
        },
        "configuration_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "toolset": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "build": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "profile"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "profile": {
              "type": "string",
              "minLength": 1
            },
            "source_revision": {
              "type": "string",
              "minLength": 1
            },
            "toolchain": {
              "type": "string",
              "minLength": 1
            },
            "default_features": {
              "type": "boolean"
            },
            "features": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "artifact_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "substrate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_commit"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success",
        "failure_class",
        "wall_seconds",
        "human_interventions",
        "candidate_exit_code",
        "verifier_exit_code"
      ],
      "properties": {
        "success": {
          "type": "boolean"
        },
        "failure_class": {
          "type": [
            "string",
            "null"
          ]
        },
        "wall_seconds": {
          "type": "number",
          "minimum": 0
        },
        "human_interventions": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_exit_code": {
          "type": "integer"
        },
        "verifier_exit_code": {
          "type": "integer"
        },
        "tool_calls": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cost": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "timed_out": {
          "type": "boolean"
        },
        "state_changed": {
          "type": "boolean"
        },
        "failure_signals": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "timeout",
              "false-completion",
              "state-unchanged",
              "invalid-tool-call",
              "authority-mismatch",
              "sandbox-helper-unavailable",
              "sandbox-user-namespace-unavailable",
              "sandbox-policy-incompatible",
              "unexpected-external-network",
              "repeated-tool-failure"
            ]
          }
        }
      }
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
