{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/SemperSupra/model-spelunker/qualification/run-receipt.schema.json",
  "title": "Configured Actor Qualification Run Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "task",
    "candidate",
    "substrate",
    "observation",
    "evidence_digest"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9-]+$"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_commit",
        "package_digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "package_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "task_class": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harness",
        "model",
        "configuration_digest",
        "toolset"
      ],
      "properties": {
        "harness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "artifact_ref": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "admission_ref": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "id"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "artifact_ref": {
              "type": "string"
            },
            "treatment_kind": {
              "type": "string",
              "enum": [
                "model",
                "router"
              ]
            }
          }
        },
        "configuration_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "toolset": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "build": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "profile"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "profile": {
              "type": "string",
              "minLength": 1
            },
            "source_revision": {
              "type": "string",
              "minLength": 1
            },
            "toolchain": {
              "type": "string",
              "minLength": 1
            },
            "default_features": {
              "type": "boolean"
            },
            "features": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "artifact_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "substrate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_commit"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "profile_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success",
        "failure_class",
        "wall_seconds",
        "human_interventions",
        "candidate_exit_code",
        "verifier_exit_code"
      ],
      "properties": {
        "success": {
          "type": "boolean"
        },
        "failure_class": {
          "type": [
            "string",
            "null"
          ]
        },
        "wall_seconds": {
          "type": "number",
          "minimum": 0
        },
        "human_interventions": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_exit_code": {
          "type": "integer"
        },
        "verifier_exit_code": {
          "type": "integer"
        },
        "tool_calls": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cost": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "timed_out": {
          "type": "boolean"
        },
        "state_changed": {
          "type": "boolean"
        },
        "failure_signals": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "timeout",
              "false-completion",
              "state-unchanged",
              "invalid-tool-call",
              "authority-mismatch",
              "sandbox-helper-unavailable",
              "sandbox-user-namespace-unavailable",
              "sandbox-policy-incompatible",
              "unexpected-external-network",
              "repeated-tool-failure",
              "engine-error-event",
              "validator-error"
            ]
          }
        },
        "cache_read_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_write_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "workload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model_rounds"
          ],
          "properties": {
            "model_rounds": {
              "type": "integer",
              "minimum": 0
            },
            "request_message_bytes_total": {
              "type": "number",
              "minimum": 0
            },
            "request_tool_schema_bytes_total": {
              "type": "number",
              "minimum": 0
            },
            "output_text_bytes_total": {
              "type": "number",
              "minimum": 0
            },
            "reasoning_bytes_total": {
              "type": "number",
              "minimum": 0
            },
            "tool_argument_bytes_total": {
              "type": "number",
              "minimum": 0
            },
            "client_wall_seconds_total": {
              "type": "number",
              "minimum": 0
            },
            "resolved_models": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "serving_providers": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "system_fingerprints": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "service_tiers": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "native_prompt_tokens_total": {
              "type": "integer",
              "minimum": 0
            },
            "native_completion_tokens_total": {
              "type": "integer",
              "minimum": 0
            },
            "native_reasoning_tokens_total": {
              "type": "integer",
              "minimum": 0
            },
            "native_cached_tokens_total": {
              "type": "integer",
              "minimum": 0
            },
            "first_event_seconds_first": {
              "type": "number",
              "minimum": 0
            },
            "first_event_seconds_min": {
              "type": "number",
              "minimum": 0
            },
            "first_event_seconds_max": {
              "type": "number",
              "minimum": 0
            },
            "provider_reported_cost_total": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "engine_error_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "mobile_action_count": {
          "type": "integer",
          "minimum": 0
        },
        "mobile_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "tool"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 1
              },
              "tool": {
                "type": "string",
                "enum": [
                  "mobile_observe_ui",
                  "mobile_tap",
                  "mobile_swipe",
                  "mobile_back",
                  "mobile_launch_settings",
                  "mobile_open_section"
                ]
              },
              "visible_nodes": {
                "type": "integer",
                "minimum": 0
              },
              "attempt": {
                "type": "integer",
                "minimum": 1
              },
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5000
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5000
              },
              "start_x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5000
              },
              "start_y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5000
              },
              "end_x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5000
              },
              "end_y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5000
              },
              "duration_ms": {
                "type": "integer",
                "minimum": 100,
                "maximum": 1500
              },
              "section": {
                "type": "string",
                "enum": [
                  "date_time"
                ]
              }
            }
          }
        }
      }
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "launch_id",
        "packet_digest"
      ],
      "properties": {
        "launch_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "maxLength": 128
        },
        "packet_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
