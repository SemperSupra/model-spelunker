{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/SemperSupra/model-spelunker/qualification/harness-admission-receipt.schema.json",
  "title": "Harness Artifact Admission Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "harness",
    "artifact",
    "admission"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "record_type": {
      "type": "string",
      "enum": [
        "harness-artifact-admission"
      ]
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "declared_version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "declared_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packaging",
        "ref",
        "digest",
        "build_receipt_digest"
      ],
      "properties": {
        "packaging": {
          "type": "string",
          "enum": [
            "oci-distribution"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "build_receipt_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "target",
        "checks"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "BUILD_ADMITTED",
            "BUILD_REJECTED"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "result"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "type": "string",
                "enum": [
                  "PASS",
                  "FAIL"
                ]
              },
              "evidence": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
