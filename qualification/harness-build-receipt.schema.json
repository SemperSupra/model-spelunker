{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/SemperSupra/model-spelunker/qualification/harness-build-receipt.schema.json",
  "title": "Harness Build Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "harness",
    "source",
    "build",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "record_type": {
      "type": "string",
      "enum": [
        "harness-build-receipt"
      ]
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "declared_version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "declared_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 7
        },
        "lockfile_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(sha256:[0-9a-f]{64})?$"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipe_id",
        "target",
        "builder_class",
        "toolchain"
      ],
      "properties": {
        "recipe_id": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "builder_class": {
          "type": "string",
          "minLength": 1
        },
        "toolchain": {
          "type": "string",
          "minLength": 1
        },
        "configuration": {
          "type": "object"
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "files"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "native-binary",
            "python-wheelhouse",
            "oci-runtime"
          ]
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  }
}
