{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/SemperSupra/model-spelunker/qualification/actor-profile.schema.json",
  "title": "Configured Actor Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "harness",
    "model",
    "execution_environment",
    "toolset"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "artifact_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "admission_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "id",
        "realization"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "realization": {
          "type": "string",
          "enum": [
            "local-artifact",
            "hosted-service",
            "router"
          ]
        },
        "artifact_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "foundry_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "execution_environment": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "venue",
        "inference_route"
      ],
      "properties": {
        "venue": {
          "type": "string",
          "minLength": 1
        },
        "inference_route": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "toolset": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "configuration": {
      "type": "object"
    },
    "authority_profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "deployment_topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harness_placement",
        "runtime_placement",
        "transport",
        "compute_class",
        "data_boundary"
      ],
      "properties": {
        "harness_placement": {
          "type": "string",
          "enum": [
            "in-process",
            "local-process",
            "local-workcell",
            "remote-workcell",
            "hosted-service",
            "unknown"
          ]
        },
        "runtime_placement": {
          "type": "string",
          "enum": [
            "same-process",
            "local-subprocess",
            "local-service",
            "remote-service",
            "hosted-service",
            "router",
            "unknown"
          ]
        },
        "transport": {
          "type": "string",
          "enum": [
            "in-process",
            "stdio",
            "unix-socket",
            "loopback-http",
            "lan-http",
            "wan-api",
            "provider-api",
            "other",
            "unknown"
          ]
        },
        "compute_class": {
          "type": "string",
          "enum": [
            "cpu",
            "gpu",
            "accelerator",
            "mixed",
            "provider-opaque",
            "deterministic",
            "unknown"
          ]
        },
        "data_boundary": {
          "type": "string",
          "enum": [
            "local-sovereign",
            "private-hosted",
            "public-safe",
            "external-provider",
            "mixed",
            "unknown"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "deployment_topology"
        ]
      }
    }
  ]
}
