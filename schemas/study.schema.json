{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SemperSupra/model-spelunker/schemas/study.schema.json",
  "title": "Model Spelunker public study declaration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "evidence_class",
    "disclosure_mode",
    "claim",
    "model",
    "stimuli",
    "dimensions",
    "acceptance"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "study_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"},
    "evidence_class": {
      "enum": [
        "computational_reproduction",
        "independent_reimplementation",
        "direct_replication",
        "conceptual_replication",
        "robustness_sensitivity",
        "generalization_transport",
        "mechanism_test",
        "benchmark_audit",
        "meta_synthesis"
      ]
    },
    "disclosure_mode": {
      "enum": ["overt_public_rep", "public_execution_private_result", "private_strategic_rep"]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "scope", "statement"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "scope": {"enum": ["engineering_example", "published_result", "scientific_hypothesis", "mechanism_claim"]},
        "statement": {"type": "string", "minLength": 1},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_id", "upstream_repository", "upstream_revision"],
      "properties": {
        "logical_id": {"type": "string"},
        "foundry_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "upstream_repository": {"type": "string"},
        "upstream_revision": {"type": "string"}
      }
    },
    "stimuli": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stimulus_id", "source"],
        "properties": {
          "stimulus_id": {"type": "string"},
          "source": {"type": "string"},
          "expected_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "dimensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "model_family", "checkpoint", "scale", "dataset", "stimulus_population",
          "language", "culture", "geography", "time", "implementation", "harness",
          "hardware", "numeric_precision", "prompt", "preprocessing", "metric",
          "evaluator", "nuisance", "adversarial_perturbation"
        ]
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_conditions", "scientific_conditions"],
      "properties": {
        "execution_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "scientific_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
